YANDEX_EMAIL=clinic@example.com
YANDEX_APP_PASSWORD=your-app-password

# Safe defaults for ChatGPT Work. Keep both values false for the clinic plugin.
YANDEX_ENABLE_ATTACHMENT_DOWNLOAD=false
YANDEX_ENABLE_UNSAFE_TOOLS=false

# Remote MCP settings. Generate a long random token; do not commit the real .env.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PUBLIC_URL=https://mail-mcp.example.com/mcp
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Bind the published Docker port to localhost when the reverse proxy is on
# this VM. Use the VM's LAN address only when the reverse proxy is elsewhere.
MCP_PUBLISH_IP=10.0.0.10
MCP_PUBLISH_PORT=8000
