# Public HTTPS URL handled by the reverse proxy (no trailing slash).
KEYCLOAK_HOSTNAME=https://auth.example.com

# Bind Keycloak only to the VM's private address.
KEYCLOAK_PUBLISH_IP=10.0.0.10
KEYCLOAK_PUBLISH_PORT=8080

# Replace all three secrets before starting. Never commit the real .env.
KEYCLOAK_ADMIN=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-a-different-long-random-password
